# Linux build host and flat RISC-V build.
CONFIG_HOST_LINUX=y
CONFIG_BUILD_FLAT=y
CONFIG_ARCH="risc-v"
CONFIG_ARCH_RISCV=y
CONFIG_ARCH_CHIP="hpm5300"
CONFIG_ARCH_CHIP_HPM5300=y
CONFIG_ARCH_CHIP_HPM5361ICB=y
CONFIG_ARCH_BOARD="helixlink"
CONFIG_ARCH_BOARD_HELIXLINK=y
CONFIG_RISCV_TOOLCHAIN_GNU_RV32=y

# CPU-local DLM: 128 KiB. Idle stack is allocated after .bss.
CONFIG_RAM_START=0x00080000
CONFIG_RAM_SIZE=131072
CONFIG_IDLETHREAD_STACKSIZE=4096

# Retain debug information with size optimization for the ILM build.
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_FULLOPT=y

# UART3 console: 115200 baud, 8 data bits, no parity, one stop bit.
CONFIG_SERIAL=y
CONFIG_DEV_CONSOLE=y
CONFIG_HPM_UART3=y
CONFIG_UART3_SERIAL_CONSOLE=y
CONFIG_UART3_BAUD=115200
CONFIG_UART3_BITS=8
CONFIG_UART3_PARITY=0
CONFIG_UART3_2STOP=0
CONFIG_UART3_RXBUFSIZE=256
CONFIG_UART3_TXBUFSIZE=256

# External NOR: probe and register MTD without changing Flash protection.
CONFIG_HPM_SPI1=y
CONFIG_SPI_EXCHANGE=y
CONFIG_HELIXLINK_SPIFLASH=y
CONFIG_W25_SPIFREQUENCY=400000
CONFIG_W25_READONLY=y

# NSH startup and built-in applications.
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_PRIORITY=100
CONFIG_INIT_STACKSIZE=2048
CONFIG_SYSTEM_NSH=y
CONFIG_NSH_LIBRARY=y
CONFIG_NSH_CONSOLE=y
CONFIG_BUILTIN=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_EXAMPLES_HELLO=y

# Temporary value for build verification; requires hardware calibration.
CONFIG_BOARD_LOOPSPERMSEC=1000
